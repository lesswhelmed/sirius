# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/sirius

# --- Auth (Better Auth) ---
# Local dev serves the web app behind portless in LAN mode at https://sirius.local
# (mDNS — reachable from the Mac, simulator, AND phones on the Wi-Fi; run
# `bun run dev:proxy` once first). NOTE: LAN mode serves ONLY the .local name —
# sirius.localhost 404s while LAN mode is active. Hostnames are defined once in
# packages/auth/dev-hosts.js; keep these URLs on one of those hosts.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_a_32_char_secret
BETTER_AUTH_URL=https://sirius.local
# Same value, exposed to the browser for the auth client.
NEXT_PUBLIC_BETTER_AUTH_URL=https://sirius.local
# Comma-separated extra origins allowed to call the auth API (BETTER_AUTH_URL is trusted automatically).
# PRODUCTION: must include the mobile deep-link scheme `siriusapp://` or the Expo auth
# client's callbacks are rejected (dev trusts it automatically). e.g. AUTH_TRUSTED_ORIGINS=siriusapp://
AUTH_TRUSTED_ORIGINS=
# Stable key Next.js uses to encrypt Server Action closures. Keep it CONSTANT across
# builds/deploys (and identical on every instance) so action IDs survive a redeploy —
# otherwise tabs from a prior build hit "Failed to find Server Action". Generate once
# with `openssl rand -base64 32`. deploy.sh requires this in production .env.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Mobile (Expo) ---
# Public base URL the mobile app (apps/mobile) talks to. Client-visible (EXPO_PUBLIC_*).
# Set per EAS build profile in apps/mobile/eas.json. NOTE: `expo start` reads its own
# apps/mobile/.env (NOT this root file) — see apps/mobile/.env.example. Listed here for
# reference only.
EXPO_PUBLIC_AUTH_BASE_URL=https://sirius.local

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender. Defaults to onboarding@resend.dev (Resend's test sender) when unset.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Ingest pipeline ---
# Bearer token clients (iOS Shortcuts, scripts) send as Authorization: Bearer <token>.
# Generate with: bun run --filter=worker setup  (writes one to this file).
INGEST_TOKEN=replace_me_with_a_long_random_hex_string

# Where the HTTP route stages image bytes before the worker persists them.
INGEST_STAGING_DIR=/tmp/sirius-ingest

# How often the worker polls for new pending submissions, in ms.
INGEST_POLL_INTERVAL_MS=5000

# Max in-flight worker jobs in one daemon. The worker caps this at 8.
INGEST_WORKER_CONCURRENCY=2

# How long SIGINT/SIGTERM waits for active worker jobs before exiting, in ms.
INGEST_SHUTDOWN_DRAIN_MS=30000

# How long an image batch may wait for all its uploads before it's abandoned
# (dead-lettered). A batch still short of totalCount after this never completes.
INGEST_BATCH_ASSEMBLY_MS=1800000

# Where the worker copies image batches so apps/web can serve them.
# Default resolves to apps/web/public/sight relative to the worker cwd.
# Set an absolute path when running under PM2/systemd/Docker.
SIGHT_IMAGE_DIR=

# Where the worker copies downloaded cover images (Instagram/social ingests).
# Default resolves to apps/web/public/social relative to the worker cwd.
SOCIAL_IMAGE_DIR=

# Override the ffmpeg binary used to extract video poster-frame thumbnails
# (video ingests → cover image). Default is the bare `ffmpeg` on PATH; if ffmpeg
# is absent the thumbnail step degrades gracefully (post publishes imageless).
FFMPEG_PATH=

# --- Private retained originals + data archives ---
# Retention policy: every uploaded original (image/audio/video/document) is kept
# on successful processing so the owner can download it. These roots MUST live
# OUTSIDE apps/web/public and must NOT be added to Caddy's file_server — all
# access is through the owner-/token-gated Next route handlers. Defaults resolve
# to <repo>/private-uploads/{originals,archives} relative to the worker/web cwd;
# set absolute paths under PM2/systemd/Docker.
ORIGINALS_DIR=
ARCHIVES_DIR=
# How long an emailed archive download link stays valid, in hours (default 168 = 7d).
ARCHIVE_TTL_HOURS=168

# --- Content-safety guardrails (worker) ---
# A decoupled Gemini gate scans user-PRODUCED material (notes, images, documents,
# audio, video, and fetched PDF-by-link) BEFORE drafting. On a harm verdict it
# creates NO post, quarantines the original, emails the admin, and removes the
# item from the user's app. See docs/safety-guardrails.md.
# Master kill switch (default on; set false to bypass the gate entirely).
SAFETY_SCAN_ENABLED=true
# Cheap classifier model for the guardrail call (NOT the drafting model).
SAFETY_MODEL=gemini-2.5-flash-lite
# Block at this severity AND above: none|low|medium|high|critical (default medium).
# child_safety is ALWAYS critical regardless of this threshold.
SAFETY_BLOCK_SEVERITY=medium
# Where flag alerts go (default saleebmina@copt.dev). Uses RESEND_API_KEY above.
SAFETY_ALERT_EMAIL=saleebmina@copt.dev
# Cap on a fetched PDF-by-link, in bytes (default 26214400 = 25 MB).
SAFETY_MAX_PDF_BYTES=26214400
# Transient-failure retries before the scan fails RETRYABLY (fail-closed; default 2).
SAFETY_SCAN_RETRIES=2
# Private quarantine root for flagged originals (evidence/CYA). Like ORIGINALS_DIR,
# this MUST live OUTSIDE apps/web/public and is NEVER fronted by Caddy. Default
# resolves to <repo>/private-uploads/quarantine.
QUARANTINE_DIR=

# Absolute base URL the emailed archive link is built on, e.g. https://lesswhelmed.com
# Falls back to BETTER_AUTH_URL, then http://localhost:3000.
ARCHIVE_LINK_BASE_URL=

# --- Worker → web cache invalidation (optional) ---
# Shared secret guarding apps/web /api/internal/revalidate. The worker sends it
# as `Authorization: Bearer <token>` after writing a post so cached lists/bodies
# refresh immediately. Both must be set or the worker silently skips revalidation.
REVALIDATE_TOKEN=
# Full URL of the revalidate endpoint, e.g. https://lesswhelmed.com/api/internal/revalidate
# In local dev keep this on http://localhost:3000 (NOT the portless URL): the worker is
# not a portless child, and the web app's dev port is pinned to 3000, so it reaches the
# endpoint directly without the proxy's TLS/CA. e.g. http://localhost:3000/api/internal/revalidate
WEB_REVALIDATE_URL=

# --- AI ---
# Primary key (GOOGLE_API_KEY / GOOGLE_GENAI_API_KEY also accepted as fallbacks).
GEMINI_API_KEY=
# Tiered text models. AI_MODEL is the standard (flash) tier used for
# note/image/video/audio drafting; AI_MODEL_HEAVY is the Pro tier used for the
# high-value url (incl. github/twitter/youtube/instagram) and document paths.
# AI_MODEL_HEAVY is a `-preview` id (no stable Gemini-3 Pro GA yet) — if Google
# retires it, bump this and re-verify with `bun run gen:try`.
AI_MODEL=gemini-3.5-flash
AI_MODEL_HEAVY=gemini-3.1-pro-preview
AI_TEMPERATURE=0.7
# Multimodal embeddings (auto-org classification). gemini-embedding-2 is GA and
# maps text + image/audio/video/pdf into one vector space via @google/genai.
EMBEDDING_MODEL=gemini-embedding-2
# MRL output size (128-3072; 768/1536/3072 recommended). Truncated dims are
# auto-renormalized by gemini-embedding-2, so cosine works directly.
EMBEDDING_DIMENSIONALITY=768

# --- Auto-generated cover images ---
# When a drafted post has no cover (notes → BLOG, plain-URL → FINDING), the
# worker renders a bespoke editorial cover so the catalog grid is never empty.
# Strictly non-fatal: a failure leaves the post imageless. Master switch:
IMAGE_GEN_ENABLED=true
# Image model. Only Nano Banana Pro honors aspectRatio/imageSize below.
IMAGE_GEN_MODEL=gemini-3-pro-image-preview
# Cheap text model that distills each post into a vivid art-direction brief.
IMAGE_GEN_BRIEF_MODEL=gemini-2.5-flash
# Aspect ratio ("1:1","2:3","3:2","3:4","4:3","9:16","16:9","21:9") and size
# ("1K","2K","4K"). 3:2 crops cleanly on both the catalog card and detail hero.
# NOTE: "2K" currently returns blank renders on the gemini-3 image models — keep
# this at "1K" until that server-side regression is resolved.
IMAGE_GEN_ASPECT_RATIO=3:2
IMAGE_GEN_SIZE=1K

# --- Auto-org (auto-file unscoped ingests under a Project/Focus Area) ---
# When a session-auth ingest has no focus selected, the worker embeds the content
# and either matches an existing Project or auto-creates an Aspiration + Project.
# Master switch; set false to disable auto-org entirely.
CLASSIFY_ENABLED=true
# Cosine threshold to reuse an existing Project instead of creating a new one
# (symmetric content/project comparison; ~0.80 for similar content).
CLASSIFY_PROJECT_MATCH_MIN=0.78
# Cosine threshold for an Analysis Category to count as relevant when naming a
# newly auto-created Project (asymmetric content/category comparison runs lower).
CLASSIFY_CATEGORY_MATCH_MIN=0.58

# --- Instagram ingest branch (Apify) ---
# Required when ingesting Instagram URLs. Paid Apify plan needed.
# https://console.apify.com/account/integrations
APIFY_TOKEN=
# Default actor: shu8hvrXbJbY3Eb9W (apify/instagram-scraper).
INSTAGRAM_ACTOR_ID=shu8hvrXbJbY3Eb9W
# How many items the Apify run should return per submitted URL.
INSTAGRAM_MAX_ITEMS=1
# Max seconds to wait for an Apify run to finish (sync mode).
INSTAGRAM_WAIT_SECS=120

# --- X / Twitter ingest branch (Apify) ---
# Reuses the shared APIFY_TOKEN above. Required when ingesting x.com/twitter.com
# status URLs (a paid Apify plan is needed).
#
# The tweet scraper is swappable via a provider registry
# (apps/worker/src/pipeline/twitter/providers.ts). Pick a registered provider:
#   apidojo — apidojo/twitter-scraper-lite (actor nfp1fpt5gUlBwPcor), single post by URL. DEFAULT.
#   kaito   — kaitoeasyapi tweet scraper, pay-per-result (~$0.18/1K tweets).
X_PROVIDER=apidojo
# Hard override for the active provider's actor id (rarely needed). Leave blank
# to use the provider's default (apidojo = nfp1fpt5gUlBwPcor).
X_ACTOR_ID=
# How many items the Apify run should return per submitted tweet (provider-
# dependent; kaito's tweetIDs mode ignores it).
X_MAX_ITEMS=1
# Max seconds to wait for an Apify run to finish (sync mode).
X_WAIT_SECS=120

# --- YouTube ingest branch ---
# Optional — without it, the worker still works via transcript-only extraction.
YOUTUBE_DATA_API_KEY=
# Must support fileData YouTube URIs. Don't downgrade to a preview model.
YOUTUBE_AI_MODEL=gemini-2.5-pro
# 45 min window, 60s overlap, 2 parallel chunks. Override for long-form video tuning.
YOUTUBE_CHUNK_SECONDS=2700
YOUTUBE_CHUNK_OVERLAP_SECONDS=60
YOUTUBE_CHUNK_PARALLEL=2

# --- Freemium (RevenueCat entitlement + AI-generation cap) ---
# Free users get this many SERVER (Gemini) AI generations per calendar week
# (Mon 00:00 UTC). On-device drafts are free and never counted. Default 10.
AI_WEEKLY_LIMIT=10
# The entitlement identifier configured in the RevenueCat dashboard that grants
# unlimited generations. Must match exactly. Default "Sirius AI Pro".
REVENUECAT_ENTITLEMENT_ID="Sirius AI Pro"
# Shared secret RevenueCat sends in the Authorization header of its webhook
# (set the same value in RevenueCat → Project → Webhooks). Required for the
# /api/revenuecat/webhook endpoint to accept events.
REVENUECAT_WEBHOOK_SECRET=
