# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/sirius

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_a_32_char_secret
BETTER_AUTH_URL=http://localhost:3000
# Same value, exposed to the browser for the auth client.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the auth API (BETTER_AUTH_URL is trusted automatically).
AUTH_TRUSTED_ORIGINS=

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender. Defaults to onboarding@resend.dev (Resend's test sender) when unset.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Ingest pipeline ---
# Bearer token clients (iOS Shortcuts, scripts) send as Authorization: Bearer <token>.
# Generate with: bun run --filter=worker setup  (writes one to this file).
INGEST_TOKEN=replace_me_with_a_long_random_hex_string

# Where the HTTP route stages image bytes before the worker persists them.
INGEST_STAGING_DIR=/tmp/sirius-ingest

# How often the worker polls for new pending submissions, in ms.
INGEST_POLL_INTERVAL_MS=5000

# Where the worker copies image batches so apps/web can serve them.
# Default resolves to apps/web/public/sight relative to the worker cwd.
# Set an absolute path when running under PM2/systemd/Docker.
SIGHT_IMAGE_DIR=

# --- AI ---
# Primary key (GOOGLE_API_KEY / GOOGLE_GENAI_API_KEY also accepted as fallbacks).
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7
EMBEDDING_MODEL=gemini-embedding-001

# --- YouTube ingest branch ---
# Optional — without it, the worker still works via transcript-only extraction.
YOUTUBE_DATA_API_KEY=
# Must support fileData YouTube URIs. Don't downgrade to a preview model.
YOUTUBE_AI_MODEL=gemini-2.5-pro
# 45 min window, 60s overlap, 2 parallel chunks. Override for long-form video tuning.
YOUTUBE_CHUNK_SECONDS=2700
YOUTUBE_CHUNK_OVERLAP_SECONDS=60
YOUTUBE_CHUNK_PARALLEL=2
