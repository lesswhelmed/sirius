.vercel

# Build Outputs
.next/
.next-builds/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Prisma generated client (regenerated on install)
packages/db/generated/

# Ingest staging
/tmp/sirius-ingest/

# Public image batches (generated by worker at runtime)
apps/web/public/sight/
# Downloaded cover images for url/social ingests (Instagram, etc.)
apps/web/public/social/

# Private retained originals + built data archives (NOT under public/, never
# served by Caddy). Worker writes here at runtime; web streams them owner-gated.
/private-uploads/

# Private local-only docs (investor agreements, etc.) — never committed.
/private/

# Testing creds (agent-browser scripts)
scripts/testing/.creds.local
.mcp.json

# Expo state (created if expo is ever run from the repo root)
.expo/

# bv (beads viewer) local config and caches
.bv/

# Marketing GIF output (record-sim-gif.sh) — big binaries, regenerate on demand
marketing-gifs/

# App Store review guide — contains the live demo-account password (rotatable);
# kept out of git. Read the credential from the local copy / .env PROD_LOGIN_PASSWORD.
docs/launch/app-store-review-guide.md

# loop-mission Stop-hook state (per-session, never commit)
.claude/loop-mission.flag
.claude/.loop-mission-state/
