# Copy to apps/mobile/.env for local Expo dev. `expo start` loads apps/mobile/.env
# automatically (it does NOT read the repo-root .env).
#
# Base URL the app talks to. In local dev the web app is served behind portless at
# https://sirius.localhost — run `bun run dev:proxy` from the repo root once to start
# the proxy and trust its CA in the iOS Simulator. Release builds set this per-profile
# in apps/mobile/eas.json instead.
EXPO_PUBLIC_AUTH_BASE_URL=https://sirius.local

# Master switch for on-device LLM drafting/chat. Unset/false hides the whole feature.
EXPO_PUBLIC_ON_DEVICE_AI=false
