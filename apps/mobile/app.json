{
	"expo": {
		"name": "Sirius",
		"slug": "sirius",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "siriusapp",
		"userInterfaceStyle": "automatic",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/c14faf73-b1f9-425e-b66b-974ac26b827c"
		},
		"ios": {
			"bundleIdentifier": "dev.copt.sirius",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"CFBundleSpokenName": "Sirius app",
				"NSSpeechRecognitionUsageDescription": "Allow Sirius to turn what you dictate into a capture for your queue."
			},
			"entitlements": {
				"com.apple.developer.kernel.increased-memory-limit": true,
				"com.apple.developer.kernel.extended-virtual-addressing": true
			}
		},
		"android": {
			"package": "dev.copt.sirius",
			"adaptiveIcon": {
				"backgroundColor": "#131923",
				"foregroundImage": "./assets/images/android-icon-foreground.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#131923",
					"android": {
						"image": "./assets/images/splash-icon.png",
						"imageWidth": 76
					}
				}
			],
			[
				"expo-share-intent",
				{
					"iosActivationRules": {
						"NSExtensionActivationSupportsText": true,
						"NSExtensionActivationSupportsWebURLWithMaxCount": 1,
						"NSExtensionActivationSupportsWebPageWithMaxCount": 1,
						"NSExtensionActivationSupportsImageWithMaxCount": 8
					},
					"iosShareExtensionName": "Share to Sirius",
					"androidIntentFilters": ["text/*", "image/*"],
					"androidMultiIntentFilters": ["image/*"]
				}
			],
			"expo-image",
			[
				"expo-image-picker",
				{
					"photosPermission": "Sirius needs access to your photo library so you can attach existing photos or videos to a capture — for example, selecting a screenshot to turn into an organized entry in your library.",
					"cameraPermission": "Sirius uses the camera so you can take a photo or record a video and save it as a capture — for example, snapping a receipt or whiteboard to draft and organize in your private library.",
					"microphonePermission": "Sirius uses the microphone so you can record a voice memo to save as a capture — for example, dictating a quick idea that Sirius drafts into an organized entry."
				}
			],
			"expo-secure-store",
			[
				"expo-local-authentication",
				{
					"faceIDPermission": "Allow Sirius to use Face ID to sign you in securely."
				}
			],
			"expo-web-browser",
			[
				"llama.rn",
				{
					"enableOpenCLAndHexagon": false
				}
			],
			"expo-background-task",
			"expo-sqlite",
			"./plugins/with-capture-intents",
			"./plugins/with-cookie-jar-hardening"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"eas": {
				"projectId": "c14faf73-b1f9-425e-b66b-974ac26b827c"
			}
		},
		"owner": "minasaleeb"
	}
}
