{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.12.0",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://lesswhelmed.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_JHDRfhioxKspkGosJYRsGDiVMJP",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_UiLlycOYEXnCXkWUIBdrcrRIeNc"
      },
      "node": "22.12.0"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://lesswhelmed.com",
        "EXPO_PUBLIC_ON_DEVICE_AI": "true",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_JHDRfhioxKspkGosJYRsGDiVMJP",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_UiLlycOYEXnCXkWUIBdrcrRIeNc"
      },
      "node": "22.12.0"
    },
    "production-device": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "L7U86T3YRV",
        "ascAppId": "6775729513"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
