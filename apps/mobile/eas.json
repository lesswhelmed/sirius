{
  // eas.json supports comments (JSONC). See https://docs.expo.dev/eas/json/
  "cli": {
    // Pin the floor; bump deliberately. Current latest at authoring: 20.0.0.
    "version": ">= 20.0.0",
    // EAS owns version/buildNumber/versionCode remotely → no manual drift,
    // no duplicate-build-number store rejections.
    "appVersionSource": "remote",
    // Only build from a clean, committed git tree (reproducibility guarantee).
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      // No EXPO_PUBLIC_AUTH_BASE_URL here → the dev client reads it from Metro
      // at runtime (apps/mobile/.env → https://sirius.local, portless LAN),
      // falling back to http://localhost:3000 (src/lib/auth-client.ts).
      "node": "22.12.0",
      "ios": {
        "simulator": true
      }
    },
    // Same dev client, provisioned for physical hardware (register the phone
    // first: `eas device:create`). Nothing is baked — the auth base URL comes
    // from Metro env at runtime, so one build follows whatever the Mac serves.
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      // Point at staging here if/when one exists; production URL for now.
      "env": {
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://lesswhelmed.com"
      },
      "node": "22.12.0"
      // REPRODUCIBILITY: pin the build image for byte-stable toolchains, e.g.
      //   "image": "<run `eas build:inspect` or see docs.expo.dev/build-reference/infrastructure>"
      // Left unset = EAS default image (deterministic per eas-cli version).
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://lesswhelmed.com"
      },
      "node": "22.12.0"
      // REPRODUCIBILITY: pin "image" here too once chosen (see preview note).
    }
  },
  "submit": {
    "production": {
      "ios": {
        // Apple Team ID for "Mina Saleeb (Individual)" (from EAS credential setup).
        "appleTeamId": "L7U86T3YRV",
        // App Store Connect app ID, discovered on the first `eas submit`
        // (2026-06-14). Lets future submits resolve the target non-interactively.
        "ascAppId": "6775729513"
      },
      "android": {
        // Google Play service-account JSON (keep out of git).
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
