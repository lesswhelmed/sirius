{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "setup": "bun run src/setup.ts",
    "backfill:covers": "bun run src/scripts/backfill-cover-images.ts",
    "backfill:video-thumbnails": "bun run src/scripts/backfill-video-thumbnails.ts",
    "scene:backfill": "bun run scripts/seed-analysis-categories.ts && bun run scripts/backfill-project-embeddings.ts && bun run scripts/backfill-post-embeddings.ts && bun run scripts/smoke-scene.ts",
    "test": "bun test",
    "smoke:categorize": "bun run scripts/smoke-categorize.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.73",
    "@danielxceron/youtube-transcript": "^1.2.6",
    "@google/genai": "^2.8.0",
    "@repo/auth": "*",
    "@repo/db": "*",
    "@repo/embedding-scene": "*",
    "@repo/extraction": "*",
    "@repo/github-ingest": "*",
    "@repo/ingest-draft": "*",
    "ai": "^6.0.182",
    "apify-client": "^2.23.3",
    "archiver": "^7.0.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "typescript": "~6.0.3"
  }
}
