# Caddy site block for sirius-2-simple — the `lesswhelmed.com` SITE ONLY.
#
# ⚠️ This is NOT the whole server config. The live /etc/caddy/Caddyfile on the
# deploy host (172.239.45.200) is SHARED and also serves `copt.dev`,
# `www.copt.dev`, and `brotanicaldistro.com`. DO NOT `cp` this file over the live
# one — that would delete those other sites. Apply it by MERGING: replace only
# the `lesswhelmed.com { … }` block in the live file with the block below, leave
# the others untouched. See ./README.md for the exact merge + validate steps.
#
# Routing inside the block is mutually-exclusive `handle` blocks:
#   1. /_next/static/*  — immutable hashed build assets (proxied to Next).
#   2. /sight/* /social/* — post media the worker writes at RUNTIME. Next's
#      static handler can only serve files present at BUILD time, so these are
#      served straight from disk by file_server here (and by in-app route
#      handlers at apps/web/app/{sight,social}/[...path] as the dev/fallback
#      path + next/image optimizer target). Keep this root in sync with
#      SIGHT_IMAGE_DIR/SOCIAL_IMAGE_DIR in .env.production. NOTE: the `file_server`
#      reads files under /home/deploy, so the `caddy` service user must be in the
#      `deploy` group (`sudo usermod -aG deploy caddy` + restart) — see README.
#   3. everything else — the Next.js server on :3003.

lesswhelmed.com {
	# Security headers applied to every response.
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	encode gzip zstd

	# 1. Immutable Next.js build assets.
	@static path /_next/static/*
	handle @static {
		header Cache-Control "public, immutable, max-age=31536000"
		reverse_proxy 127.0.0.1:3003
	}

	# 2. Runtime-written post media, served from disk (bypasses Node).
	#    Request /sight/<batch>/1.jpg -> <root>/sight/<batch>/1.jpg.
	#
	# ⚠️ Serve ONLY /sight/* and /social/* here. The PRIVATE retained originals
	# and built data archives (ORIGINALS_DIR / ARCHIVES_DIR, default
	# <repo>/private-uploads/...) must NEVER be added to this file_server — they
	# hold users' raw uploads and are owner-/token-gated by the Next route
	# handlers (/api/app/posts/[slug]/source, /api/app/archive/download). Keep
	# them outside this `root` so file_server can't reach them.
	@media path /sight/* /social/*
	handle @media {
		root * /home/deploy/apps/sirius/apps/web/public
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# 3. Everything else -> Next.js.
	handle {
		reverse_proxy 127.0.0.1:3003 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
		}
	}
}

# MCP corpus server (apps/mcp, PM2: sirius-mcp) on :3005. A SEPARATE site block,
# not a handle inside lesswhelmed.com — external MCP hosts connect here with a
# user-issued API key (Authorization: Bearer). No static assets or media; the
# whole surface is the stateless Streamable-HTTP endpoint. Merge this block into
# the live shared /etc/caddy/Caddyfile alongside the others (see README).
mcp.lesswhelmed.com {
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	encode gzip zstd

	reverse_proxy 127.0.0.1:3005 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
	}
}
