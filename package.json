{
  "name": "sirius-2-simple",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:migrate:dev": "turbo run db:migrate:dev --filter=@repo/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@repo/db",
    "db:push": "turbo run db:push --filter=@repo/db",
    "db:studio": "turbo run db:studio --filter=@repo/db",
    "worker:dev": "turbo run dev --filter=worker",
    "worker:setup": "turbo run setup --filter=worker"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "better-auth": "^1.6.11"
  }
}
