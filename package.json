{
  "name": "sirius-2-simple",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:migrate:dev": "turbo run db:migrate:dev --filter=@repo/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@repo/db",
    "db:push": "turbo run db:push --filter=@repo/db",
    "db:studio": "turbo run db:studio --filter=@repo/db",
    "worker:dev": "turbo run dev --filter=worker",
    "worker:setup": "turbo run setup --filter=worker",
    "env:production": "bun run scripts/create-production-env.ts",
    "deploy": "bash scripts/deploy-remote.sh"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "turbo": "^2.9.16",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "better-auth": "^1.6.13"
  },
  "overrides": {
    "kysely": "0.28.17",
    "expo": "56.0.8",
    "expo-constants": "56.0.16",
    "expo-linking": "56.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
