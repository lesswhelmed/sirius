// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  content       String
  excerpt       String?
  type          PostType
  status        PostStatus @default(DRAFT)
  filePath      String
  fileHash      String
  findingsCount Int?
  originalDate  DateTime?
  originalUrl   String?
  imageUrl      String? // hero / cover image (for SIGHT batches: images[0].url)
  images        Json? // SIGHT gallery: [{ url, alt }] in upload order; null for non-photo posts
  contentDigest Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastEdited    DateTime   @updatedAt
  published     Boolean    @default(false)

  // Provider provenance — tracks where this post came from
  sourceType     String    @default("mdx") // "mdx" | "json" | "api" | "ingest"
  providerId     String    @default("filesystem") // provider identifier
  sourceRecordId String? // external/provider-specific record id
  sourceHash     String? // hash of the source record for change detection
  syncStatus     String    @default("synced") // "synced" | "pending" | "error" | "tombstone"
  lastSyncedAt   DateTime?

  // Broker attribution: the user who ingested this listing.
  submittedById String?
  submittedBy   User?   @relation("UserPosts", fields: [submittedById], references: [id], onDelete: SetNull)

  // Organization: the Project (Focus Area) this post is filed under. A post
  // belongs to at most one Project; SetNull so content outlives its container.
  projectId String?
  project   Project? @relation("ProjectPosts", fields: [projectId], references: [id], onDelete: SetNull)

  embedding       PostEmbedding?      @relation("PostEmbedding")
  categoryMatches PostCategoryMatch[] @relation("PostCategoryMatches")

  tags            Tag[]           @relation("PostToTag")
  categories      Category[]      @relation("PostToCategory")
  hlexiconEntries HlexiconEntry[] @relation("PostToHlexicon")
  savedBy         SavedPost[]     @relation("PostSaves")
  views           PostView[]      @relation("PostViews")

  // prevent cross-provider slug collisions
  @@unique([providerId, slug])
  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([published])
  @@index([providerId])
  @@index([syncStatus])
  @@index([submittedById])
  @@index([submittedById, status, createdAt])
  @@index([projectId])
}

enum PostType {
  CONCRETE
  BLOG
  FINDING
  SIGHT
  SOCIAL
}

enum PostStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToTag")

  @@index([slug])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique // Keep as kebab-case to match embeddings
  displayName String // Human-readable name
  slug        String @unique
  posts       Post[] @relation("PostToCategory")

  @@index([slug])
  @@index([name])
}

model HlexiconEntry {
  id         String   @id @default(cuid())
  term       String   @unique
  definition String
  posts      Post[]   @relation("PostToHlexicon")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([term])
}

model CategoryEmbedding {
  id             String   @id @default(cuid())
  path           String   @unique
  name           String
  // Optional human-readable label for dynamic topic nodes (seed facets derive
  // their label from `name`). Used as the Tree node label when present.
  displayName    String?
  // "seed"    = the fixed analysis-facet taxonomy (seed-analysis-categories.ts)
  // "dynamic" = a topic node grown at ingest by the category resolver.
  // Lets the resolver scope its reuse comparison to dynamic siblings only.
  source         String   @default("dynamic")
  fullPath       String
  parentPath     String?
  depth          Int
  fileCount      Int
  // What belongs in this analysis category.
  description    String
  // Why this category exists for classification (distinct from description).
  // Embedded alongside description so reverse-lookup matches on intent, not just
  // surface terms.
  purpose        String   @default("")
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([path])
  @@index([parentPath])
  @@index([depth])
  @@index([embeddingHash])
  @@index([source])
}

// One embedding per Project (Focus Area), so unscoped content can be matched to
// an existing Project via cosine similarity. ownerId is denormalized for cheap
// owner-scoped reverse lookups without a Project join.
model ProjectEmbedding {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation("ProjectEmbedding", fields: [projectId], references: [id], onDelete: Cascade)
  ownerId        String
  retrievalText  String
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([embeddingHash])
}

// One embedding per Post, persisted by the worker at classify time (or by the
// backfill script). ownerId denormalizes Post.submittedById for cheap
// owner-scoped scene reads; null = bearer ingest (excluded from per-user scenes).
model PostEmbedding {
  id             String   @id @default(cuid())
  postId         String   @unique
  post           Post     @relation("PostEmbedding", fields: [postId], references: [id], onDelete: Cascade)
  ownerId        String?
  retrievalText  String
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([embeddingHash])
}

// Linkage: which Analysis Categories a post matched at classify time (top-K above
// threshold). path is a soft reference to CategoryEmbedding.path (taxonomy rows
// are keyed/upserted by path). Kept as rows, not JSON, so the scene API and
// future queries can traverse post<->category links relationally.
model PostCategoryMatch {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation("PostCategoryMatches", fields: [postId], references: [id], onDelete: Cascade)
  path      String
  score     Float
  createdAt DateTime @default(now())

  @@unique([postId, path])
  @@index([path])
}

model IngestSubmission {
  id             String    @id @default(cuid())
  kind           String // "url" | "image" | "note"
  payload        Json // raw normalized request payload
  contentHash    String    @unique // dedup key; force=true salts the hash
  batchId        String? // groups image rows that should become one SIGHT post
  imageIndex     Int?
  totalCount     Int?
  stagedFilePath String? // absolute path to staged binary on the host
  status         String    @default("pending") // "pending" | "processing" | "completed" | "failed" | "skipped"
  attempts       Int       @default(0)
  force          Boolean   @default(false) // bypass idempotent reprocessing skip; regenerate
  errorMessage   String?
  resultPostSlug String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  // Broker attribution: which user kicked off this ingest. Worker copies onto Post.
  submittedById String?
  submittedBy   User?   @relation("UserSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  // Seam (intake): submit-time Project assignment. Worker copies onto Post,
  // mirroring submittedById. Not wired into the composer yet.
  projectId String?
  project   Project? @relation("ProjectSubmissions", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([batchId])
  @@index([kind])
  @@index([submittedById])
  @@index([projectId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserSaves", fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation("PostSaves", fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation("PostViews", fields: [postId], references: [id], onDelete: Cascade)
  viewerId  String? // null for anonymous; set when a session is present
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([postId, viewerId])
}

model TagEmbedding {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  postCount      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([embeddingHash])
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Schema for better-auth + admin plugin. Field names match Better Auth
// conventions; do not rename without updating the auth config.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Broker storefront
  handle   String? @unique
  bio      String?
  location String?

  sessions    Session[]
  accounts    Account[]
  posts       Post[]             @relation("UserPosts")
  submissions IngestSubmission[] @relation("UserSubmissions")
  saves             SavedPost[]  @relation("UserSaves")
  aspirations Aspiration[]       @relation("UserAspirations")
  projects    Project[]          @relation("UserProjects")

  @@index([email])
  @@index([handle])
  @@map("user")
}

// ─── Organization (lesswhelmed Aspiration Core) ─────────────────────────────
// Aspiration = a high-level user goal. Project = a concrete Focus Area under an
// Aspiration (or standalone). Posts/submissions are filed under one Project.

model Aspiration {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int?
  metadata    Json? // seam: later intake-question config / automation rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("UserAspirations", fields: [ownerId], references: [id], onDelete: Cascade)

  projects Project[] @relation("AspirationProjects")

  @@index([ownerId, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("active") // "active" | "archived" (mirrors IngestSubmission status style)
  sortOrder   Int?
  metadata    Json? // seam: later intake-question config / automation rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("UserProjects", fields: [ownerId], references: [id], onDelete: Cascade)

  // Standalone-capable: a Project may have no Aspiration.
  aspirationId String?
  aspiration   Aspiration? @relation("AspirationProjects", fields: [aspirationId], references: [id], onDelete: SetNull)

  posts       Post[]             @relation("ProjectPosts")
  submissions IngestSubmission[] @relation("ProjectSubmissions")
  embedding   ProjectEmbedding?  @relation("ProjectEmbedding")

  @@index([ownerId, status, createdAt])
  @@index([aspirationId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // admin plugin
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
