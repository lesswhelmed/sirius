// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  content       String
  excerpt       String?
  type          PostType
  status        PostStatus     @default(DRAFT)
  // Who may READ this post. PRIVATE (owner only) is the safe default; FRIENDS
  // opens it to the owner's accepted friends; PUBLIC opens it to any signed-in
  // user (gated by PUBLIC_CATALOG_ENABLED at the surface). The read decision
  // lives in canReadPost() (apps/web/lib/post-access.ts) — never hardcode it.
  visibility    PostVisibility @default(PRIVATE)
  filePath      String
  fileHash      String
  findingsCount Int?
  originalDate  DateTime?
  originalUrl   String?
  imageUrl      String? // hero / cover image (for SIGHT batches: images[0].url)
  images        Json? // SIGHT gallery: [{ url, alt }] in upload order; null for non-photo posts
  contentDigest Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastEdited    DateTime       @updatedAt
  published     Boolean        @default(false)

  // Generated full-text search vector over title+excerpt+content. Managed by a
  // hand-authored migration (Postgres GENERATED STORED column) and queried only
  // via raw SQL (searchCorpus → websearch_to_tsquery). Typed Unsupported so
  // Prisma knows the column exists without trying to write or select it.
  searchVector Unsupported("tsvector")?

  // Provider provenance — tracks where this post came from
  sourceType     String    @default("mdx") // "mdx" | "json" | "api" | "ingest"
  providerId     String    @default("filesystem") // provider identifier
  sourceRecordId String? // external/provider-specific record id
  sourceHash     String? // hash of the source record for change detection
  syncStatus     String    @default("synced") // "synced" | "pending" | "error" | "tombstone"
  lastSyncedAt   DateTime?

  // Broker attribution: the user who ingested this listing.
  submittedById String?
  submittedBy   User?   @relation("UserPosts", fields: [submittedById], references: [id], onDelete: SetNull)

  // Organization: the Project (Focus Area) this post is filed under. A post
  // belongs to at most one Project; SetNull so content outlives its container.
  projectId String?
  project   Project? @relation("ProjectPosts", fields: [projectId], references: [id], onDelete: SetNull)

  embedding       PostEmbedding?      @relation("PostEmbedding")
  categoryMatches PostCategoryMatch[] @relation("PostCategoryMatches")

  // Precomputed kNN post↔post similarity edges (the mind-map links), rebuilt in
  // the background by the worker. A post appears as either endpoint, so two
  // back-relations; both cascade so deleting a post removes every edge touching it.
  neighbors  PostNeighbor[] @relation("PostNeighborsFrom")
  neighborOf PostNeighbor[] @relation("PostNeighborsTo")

  // The ingest submission(s) that produced this post (1 for url/note/file,
  // N for a SIGHT image batch). Used to resolve a post's retained originals.
  sourceSubmissions IngestSubmission[] @relation("PostSourceSubmissions")

  tags            Tag[]           @relation("PostToTag")
  categories      Category[]      @relation("PostToCategory")
  hlexiconEntries HlexiconEntry[] @relation("PostToHlexicon")
  savedBy         SavedPost[]     @relation("PostSaves")
  views           PostView[]      @relation("PostViews")
  comments        Comment[]       @relation("PostComments")

  // The share groups this post is shared with (only meaningful when
  // visibility = GROUP). Cascades when the post or a group is deleted.
  shareGroups PostShareGroup[] @relation("PostShareGroups")

  // UGC moderation: viewer flags on this post. Cascade — a deleted post's
  // reports are moot (the content is gone).
  reports ContentReport[] @relation("PostReports")

  // prevent cross-provider slug collisions
  @@unique([providerId, slug])
  // a post's true identity: re-processing the same source updates this row
  // instead of creating a duplicate (post-writer.resolveSlug relies on this).
  @@unique([providerId, sourceRecordId])
  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([published])
  @@index([providerId])
  @@index([syncStatus])
  @@index([submittedById])
  @@index([submittedById, status, createdAt])
  // friends-feed query: a viewer's friends' FRIENDS posts, newest first
  @@index([submittedById, visibility, createdAt])
  // PUBLIC catalog scan (when enabled) without a full table scan
  @@index([visibility, status, createdAt])
  @@index([projectId])
  // Full-text search over post bodies (GIN on the trigger-maintained tsvector).
  // The index itself is created by the hand-authored migration; declared here so
  // the schema reflects the live database. `map:` pins Prisma's expected index
  // name to the migration's actual name so a future `migrate dev` won't try to
  // rename it (Prisma's default would be `Post_searchVector_idx`).
  @@index([searchVector], type: Gin, map: "post_search_vector_idx")
}

enum PostType {
  CONCRETE
  BLOG
  FINDING
  SIGHT
  SOCIAL
}

enum PostStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum PostVisibility {
  PRIVATE // owner only (default — safe)
  FRIENDS // owner + the owner's accepted friends
  GROUP // owner + current members of the ShareGroup(s) this post is linked to.
  //         Each member must ALSO still be an accepted friend — the read decision
  //         lives in canReadPost() (isPostSharedWithViaGroup), never hardcode it.
  //         A GROUP post with zero links is owner-only (safe, never widens).
  PUBLIC // any signed-in user (gated by PUBLIC_CATALOG_ENABLED at the surface)
}

// Per-group identity exposure. Default is the most-private: recipients get read
// access to shared posts but never see the group's name or who else is in it (the
// group is invisible to non-owners). NAMED lets members see the name + co-member
// roster. The DEFAULT is PRIVATE so a new group leaks nothing.
enum ShareGroupVisibility {
  PRIVATE // only the owner sees the name + roster; group identity hidden from members
  NAMED // members may see the group name + co-member roster
}

// A named, reusable audience of the owner's friends. The owner shares posts with
// one OR MORE groups (Post.visibility = GROUP + PostShareGroup rows). Membership
// targets must be the owner's CURRENT accepted friends at add time; unfriending
// cascade-removes the pair from each other's groups (see friends.removeFriend).
model ShareGroup {
  id         String               @id @default(cuid())
  ownerId    String
  owner      User                 @relation("UserShareGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  visibility ShareGroupVisibility @default(PRIVATE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  members   ShareGroupMember[] @relation("ShareGroupMembers")
  postLinks PostShareGroup[]   @relation("ShareGroupPostLinks")

  @@unique([ownerId, name]) // one group name per owner
  @@index([ownerId])
  @@map("ShareGroup")
}

// One row per (group, member). Cascades on group delete AND on user delete, so a
// deleted account leaves no dangling membership and a deleted group cleans up.
model ShareGroupMember {
  id        String     @id @default(cuid())
  groupId   String
  group     ShareGroup @relation("ShareGroupMembers", fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("UserShareGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId]) // "which groups is this viewer a member of" — the read path
  @@index([groupId])
}

// Explicit Post <-> ShareGroup join: which groups a post is shared with. Explicit
// (not implicit m2m) because the worker writes these rows create-only, the
// feed/search read predicate filters through it, and cascade is explicit on both
// sides.
model PostShareGroup {
  id        String     @id @default(cuid())
  postId    String
  post      Post       @relation("PostShareGroups", fields: [postId], references: [id], onDelete: Cascade)
  groupId   String
  group     ShareGroup @relation("ShareGroupPostLinks", fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, groupId])
  @@index([groupId])
  @@index([postId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToTag")

  @@index([slug])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique // Keep as kebab-case to match embeddings
  displayName String // Human-readable name
  slug        String @unique
  posts       Post[] @relation("PostToCategory")

  @@index([slug])
  @@index([name])
}

model HlexiconEntry {
  id         String   @id @default(cuid())
  term       String   @unique
  definition String
  posts      Post[]   @relation("PostToHlexicon")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([term])
}

model CategoryEmbedding {
  id             String   @id @default(cuid())
  path           String   @unique
  name           String
  // Optional human-readable label for dynamic topic nodes (seed facets derive
  // their label from `name`). Used as the Tree node label when present.
  displayName    String?
  // "seed"    = the fixed analysis-facet taxonomy (seed-analysis-categories.ts)
  // "dynamic" = a topic node grown at ingest by the category resolver.
  // Lets the resolver scope its reuse comparison to dynamic siblings only.
  source         String   @default("dynamic")
  fullPath       String
  parentPath     String?
  depth          Int
  fileCount      Int
  // What belongs in this analysis category.
  description    String
  // Why this category exists for classification (distinct from description).
  // Embedded alongside description so reverse-lookup matches on intent, not just
  // surface terms.
  purpose        String   @default("")
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([path])
  @@index([parentPath])
  @@index([depth])
  @@index([embeddingHash])
  @@index([source])
}

// One embedding per Project (Focus Area), so unscoped content can be matched to
// an existing Project via cosine similarity. ownerId is denormalized for cheap
// owner-scoped reverse lookups without a Project join.
model ProjectEmbedding {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation("ProjectEmbedding", fields: [projectId], references: [id], onDelete: Cascade)
  ownerId        String
  retrievalText  String
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([embeddingHash])
}

// One embedding per Post, persisted by the worker at classify time (or by the
// backfill script). ownerId denormalizes Post.submittedById for cheap
// owner-scoped scene reads; null = bearer ingest (excluded from per-user scenes).
model PostEmbedding {
  id             String   @id @default(cuid())
  postId         String   @unique
  post           Post     @relation("PostEmbedding", fields: [postId], references: [id], onDelete: Cascade)
  ownerId        String?
  retrievalText  String
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([embeddingHash])
}

// Linkage: which Analysis Categories a post matched at classify time (top-K above
// threshold). path is a soft reference to CategoryEmbedding.path (taxonomy rows
// are keyed/upserted by path). Kept as rows, not JSON, so the scene API and
// future queries can traverse post<->category links relationally.
model PostCategoryMatch {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation("PostCategoryMatches", fields: [postId], references: [id], onDelete: Cascade)
  path      String
  score     Float
  createdAt DateTime @default(now())

  @@unique([postId, path])
  @@index([path])
}

model IngestSubmission {
  id             String    @id @default(cuid())
  kind           String // "url" | "image" | "note" | "video" | "audio" | "document"
  payload        Json // raw normalized request payload
  // Dedup key; force=true salts the hash. Uniqueness is PARTITIONED, not global:
  // two PARTIAL unique indexes (hand-authored in migration
  // 20260704120000_ingest_per_submitter_dedup — Prisma DSL cannot express WHERE
  // indexes) enforce (1) global uniqueness for unattributed bearer rows
  // (submittedById IS NULL) and (2) per-submitter uniqueness for attributed rows
  // (submittedById IS NOT NULL). So user B can submit the same contentHash as user
  // A and still get their own row. The `@unique` was dropped for exactly this;
  // schema/DB drift on the partial indexes is expected + documented in the migration.
  contentHash    String
  batchId        String? // groups image rows that should become one SIGHT post
  imageIndex     Int?
  totalCount     Int?
  stagedFilePath String? // absolute path to staged binary on the host
  status         String    @default("pending") // "pending" | "processing" | "completed" | "failed" | "skipped" | "flagged"
  attempts       Int       @default(0)
  force          Boolean   @default(false) // bypass idempotent reprocessing skip; regenerate
  errorMessage   String?
  resultPostSlug String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  // Set when the content-safety gate rejects this submission (terminal status
  // "flagged"). No Post is created; the original is moved to quarantine and a
  // ModerationEvent records the verdict. See apps/worker/src/pipeline/safety.
  flaggedAt      DateTime?

  // Retained original (liability/retention). On successful processing the worker
  // MOVES the staged binary into ORIGINALS_DIR and records its absolute path here
  // instead of deleting it. Null for url/note kinds (no binary) and for rows still
  // pending/failed. Owner downloads stream from this path; never served publicly.
  retainedFilePath  String?
  originalMimeType  String?
  originalSizeBytes Int?
  originalFilename  String?

  // Broker attribution: which user kicked off this ingest. Worker copies onto Post.
  submittedById String?
  submittedBy   User?   @relation("UserSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  // Seam (intake): submit-time Project assignment. Worker copies onto Post,
  // mirroring submittedById. Not wired into the composer yet.
  projectId String?
  project   Project? @relation("ProjectSubmissions", fields: [projectId], references: [id], onDelete: SetNull)

  // Per-capture post visibility chosen in the composer at submit time. The worker
  // copies it onto the Post it creates (create-only, like status — never clobbers a
  // later manual visibility edit). Null → fall back to Post.visibility's PRIVATE
  // default: bearer submits that omit it, FRIENDS coerced away for unattributed
  // bearer ingests, and pre-migration rows.
  visibility PostVisibility?

  // Composer's chosen share-group ids at submit time, copied onto PostShareGroup
  // by the worker (create-only, like visibility). Empty → no group sharing. Only
  // meaningful when visibility = GROUP and there's an attributed submitter
  // (validated in apps/web/lib/ingest/submit.ts).
  shareGroupIds String[] @default([])

  // The Post this submission produced. A SIGHT post maps to N image rows, so the
  // relation lets a post resolve all its source originals. resultPostSlug is kept
  // for back-compat; this FK is the lookup path. SetNull so a post delete doesn't
  // cascade-delete submissions (the delete path removes them explicitly).
  resultPostId String?
  resultPost   Post?   @relation("PostSourceSubmissions", fields: [resultPostId], references: [id], onDelete: SetNull)

  // Safety-flag audit rows for this submission (CYA). Cascades on submission
  // delete only because the submission FK is the anchor; the quarantined files
  // and the evidence in the row are retained independently of the submission.
  moderationEvents ModerationEvent[] @relation("SubmissionModeration")

  @@index([status])
  @@index([batchId])
  @@index([kind])
  @@index([submittedById])
  @@index([projectId])
  @@index([resultPostId])
}

// Audit record for a content-safety flag (CYA / evidence). One row per flagged
// submission (an image batch shares one event, keyed off the batch's anchor
// submission). The actual material is preserved at quarantinePaths, OUTSIDE any
// served directory. These rows are evidence — never surfaced in any user UI.
model ModerationEvent {
  id              String   @id @default(cuid())
  submissionId    String
  submission      IngestSubmission @relation("SubmissionModeration", fields: [submissionId], references: [id], onDelete: Cascade)
  // Submitting user as a plain string (NOT a FK) so deleting a user never erases
  // the audit trail.
  submittedById   String?
  kind            String   // submission kind: note | image | document | audio | video | url
  action          String   // "flag" | "flag_critical"
  severity        String   // none | low | medium | high | critical
  categories      String[] // matched SafetyCategory values
  rationale       String?  // internal classifier rationale; never shown to the user
  model           String   // classifier model id
  contentHash     String?
  quarantinePaths String[] // absolute paths to quarantined evidence files
  emailedAt       DateTime? // when the admin alert was sent
  // Manual review outcome (admin, out-of-band — no dashboard in v1).
  reviewedById    String?
  reviewedAt      DateTime?
  resolution      String?  // "uphold" | "overturn"
  createdAt       DateTime @default(now())

  @@index([submissionId])
  @@index([severity])
  @@index([createdAt])
}

// A user-requested zip archive of all their retained originals + note text.
// Built asynchronously by the worker; delivered via a time-limited token link
// (emailed). status: pending → processing → ready | failed | expired.
model ArchiveRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserArchiveRequests", fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("pending")
  attempts     Int       @default(0)
  token        String?   @unique // url-safe random; set when ready
  fileCount    Int?
  sizeBytes    Int?
  downloadPath String? // absolute path of the built zip under ARCHIVES_DIR
  expiresAt    DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([token])
}

// Precomputed post↔post similarity edges (kNN over PostEmbedding vectors), the
// expensive O(n²) part of the scene. Built in the background by the worker so the
// scene-load path never recomputes it. ownerId is denormalized (like
// PostEmbedding.ownerId) for cheap owner-scoped reads; one row per undirected pair
// (postId < neighborId by convention). Cascades on either post delete.
model PostNeighbor {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation("PostNeighborsFrom", fields: [postId], references: [id], onDelete: Cascade)
  neighborId String
  neighbor   Post     @relation("PostNeighborsTo", fields: [neighborId], references: [id], onDelete: Cascade)
  score      Float // cosine similarity
  ownerId    String
  createdAt  DateTime @default(now())

  @@unique([postId, neighborId])
  @@index([ownerId])
  @@index([neighborId])
}

// Cached force-layout for an owner's scene: node positions + visual hints, so the
// scene API reads + assembles instead of recomputing PCA/force/kNN per request.
// One row per owner (rewritten on each recompute). Positions are owner-scoped even
// for the GLOBAL categories because the layout depends on the owner's whole graph,
// so they cannot live on the shared CategoryEmbedding row. Best-effort: a missing
// row means "compute live + enqueue", never an error.
model SceneLayout {
  id             String   @id @default(cuid())
  ownerId        String   @unique
  positions      Json // { [nodeId]: [x, y, z] }
  weights        Json // { [nodeId]: number } — node importance for radius
  clusters       Json // { [postId]: categoryPath } — dominant category for hue
  modelVersion   String
  dimensionality Int
  generatedAt    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Debounced background job: "this owner's scene needs recomputing". Mirrors
// ArchiveRequest's claim/lease pattern off the same worker poll loop. Enqueued
// (deduped to one in-flight per owner) whenever the owner's graph changes — a new
// PostEmbedding, a reclassification, a project reassignment, or a post delete.
// Successful runs DELETE the row (output lives in SceneLayout/PostNeighbor), so the
// table stays tiny; failures retain it for retry/inspection.
model SceneRecomputeRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserSceneRecomputes", fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("pending") // pending → processing → failed (success deletes)
  attempts     Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserSaves", fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation("PostSaves", fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation("PostViews", fields: [postId], references: [id], onDelete: Cascade)
  viewerId  String? // null for anonymous; set when a session is present
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([postId, viewerId])
}

// A comment on a post. Owner-scoped today (only the post owner comments on their
// own posts), but the shape is deliberately agent-ready: authorKind distinguishes
// a human (USER, authorId set) from a future AI responder (AGENT, authorId null +
// agentName label), so a Gemini reply can drop into the same thread with no
// migration. Soft-deleted via status="tombstone" (not a hard delete) so the
// change propagates through the same updatedAt delta feed the mobile mirror uses
// for posts (listCommentsChangedSince mirrors listPostsChangedSince).
model Comment {
  id         String            @id @default(cuid())
  postId     String
  post       Post              @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  authorKind CommentAuthorKind @default(USER)
  // Null when authorKind=AGENT (no user row) or the human author deleted their
  // account (SetNull). USER comments always carry it at write time.
  authorId   String?
  author     User?             @relation("UserComments", fields: [authorId], references: [id], onDelete: SetNull)
  agentName  String? // display label for AGENT authors (e.g. "Gemini"); null for USER
  body       String
  status     String            @default("active") // "active" | "tombstone"
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([updatedAt]) // delta since-cursor scans (listCommentsChangedSince)
}

enum CommentAuthorKind {
  USER
  AGENT
}

model TagEmbedding {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  embedding      Float[]
  embeddingHash  String
  modelVersion   String
  dimensionality Int
  postCount      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([embeddingHash])
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Schema for better-auth + admin plugin. Field names match Better Auth
// conventions; do not rename without updating the auth config.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Broker storefront
  handle       String? @unique
  bio          String?
  location     String?
  voiceProfile String?

  // App Store 1.2 (UGC safety): when the user agreed to the Terms of Use.
  // Null = pre-terms account → clients show the one-time acceptance gate.
  // Surfaced on the session via better-auth user.additionalFields (input:
  // false — written exclusively server-side at sign-up / accept-terms).
  termsAcceptedAt DateTime?

  sessions        Session[]
  accounts        Account[]
  posts           Post[]                  @relation("UserPosts")
  submissions     IngestSubmission[]      @relation("UserSubmissions")
  saves           SavedPost[]             @relation("UserSaves")
  aspirations     Aspiration[]            @relation("UserAspirations")
  projects        Project[]               @relation("UserProjects")
  archiveRequests ArchiveRequest[]        @relation("UserArchiveRequests")
  sceneRecomputes SceneRecomputeRequest[] @relation("UserSceneRecomputes")
  comments        Comment[]               @relation("UserComments")
  apiKeys         ApiKey[]                @relation("UserApiKeys")

  // Friendships are stored as ONE canonically-ordered row per pair (userAId <
  // userBId). A user therefore appears as either side, so two back-relations.
  friendshipsA Friendship[] @relation("FriendshipA")
  friendshipsB Friendship[] @relation("FriendshipB")

  // Share groups this user OWNS, and the groups they are a MEMBER of (someone
  // else's group). Both cascade on user delete.
  shareGroups           ShareGroup[]       @relation("UserShareGroups")
  shareGroupMemberships ShareGroupMember[] @relation("UserShareGroupMemberships")

  // UGC moderation: reports this user filed, and directional blocks. A user
  // appears as either side of a block, so two back-relations.
  contentReports ContentReport[] @relation("UserContentReports")
  blocksMade     UserBlock[]     @relation("UserBlocksMade")
  blocksReceived UserBlock[]     @relation("UserBlocksReceived")

  // Freemium: RevenueCat-sourced "Sirius AI Pro" entitlement (1:1) + the ledger
  // of server (Gemini) AI generations this user has consumed (for the weekly cap).
  entitlement   UserEntitlement?    @relation("UserEntitlement")
  aiGenerations AiGenerationEvent[] @relation("UserAiGenerations")

  @@index([email])
  @@index([handle])
  @@map("user")
}

// ─── Freemium (RevenueCat entitlement + AI-generation metering) ──────────────
// Server AI drafting (the worker's Gemini call) is capped per week for free
// users; paying for "Sirius AI Pro" lifts the cap. RevenueCat is the source of
// truth — its webhook writes UserEntitlement; the worker reads it. On-device
// drafting is free local compute and is NOT metered.

// One row per user, created lazily on the first RevenueCat webhook (or first
// entitlement check). isPro is the worker's bypass switch; expiresAt lets a
// lapsed sub self-expire even if the EXPIRATION webhook is missed. rcAppUserId
// is RevenueCat's app_user_id, which we require to equal our User.id so a
// server-to-server webhook can resolve back to the user.
model UserEntitlement {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation("UserEntitlement", fields: [userId], references: [id], onDelete: Cascade)
  isPro         Boolean   @default(false)
  rcAppUserId   String?   @unique
  rcCustomerId  String?
  entitlementId String? // e.g. "Sirius AI Pro"
  productId     String?
  store         String? // RevenueCat event.store: "APP_STORE" | "PLAY_STORE" | ...
  expiresAt     DateTime? // entitlement expiration; null = no active sub (or lifetime)
  // Idempotency / ordering guard for webhook replays + out-of-order delivery.
  lastEventId   String?
  lastEventAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([rcAppUserId])
  @@index([expiresAt])
}

// One row per SERVER (Gemini) generation. Free users reserve a row before the
// model call, then complete it after the post write. Weekly usage counts
// completed rows plus non-expired reservations so parallel workers cannot all
// pass the same read. resultPostId is a soft reference (no FK) to the produced post.
model AiGenerationEvent {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation("UserAiGenerations", fields: [userId], references: [id], onDelete: Cascade)
  kind                 String // ingest kind: "url"|"note"|"image"|"video"|"audio"|"document"
  resultPostId         String?
  sourceRecordId       String?
  status               String   @default("completed") // "reserved" | "completed"
  reservationExpiresAt DateTime?
  createdAt            DateTime @default(now())

  @@unique([userId, sourceRecordId])
  @@index([userId, createdAt])
  @@index([userId, status, reservationExpiresAt])
}

// A mutual friendship between two users, in any lifecycle state. Stored as a
// SINGLE row per pair with a canonical ordering (userAId < userBId, string
// compare) so "are A and B friends" is one unique-key lookup regardless of who
// asked. `requestedById` remembers direction (incoming vs outgoing). A request
// and an accepted friendship are the same row in different `status` states, so
// accept/decline are atomic updates — no row move, no A↔B duplicate possible.
// The canonical ordering is computed by ONE helper (orderPair in
// packages/db/src/friends.ts); no caller builds the pair by hand.
model Friendship {
  id            String           @id @default(cuid())
  userAId       String
  userBId       String
  userA         User             @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User             @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  status        FriendshipStatus @default(PENDING)
  requestedById String // always one of userAId/userBId — who sent the request
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  acceptedAt    DateTime? // set when status first becomes ACCEPTED

  @@unique([userAId, userBId]) // one relationship row per pair; DB-enforced dedup
  @@index([userAId, status])
  @@index([userBId, status])
  @@index([requestedById])
  @@map("friendship")
}

enum FriendshipStatus {
  PENDING // requestedById asked the other; awaiting accept/decline
  ACCEPTED // mutual friends
  DECLINED // recipient declined; kept (not deleted) to throttle re-spam
  BLOCKED // superseded by the directional UserBlock model; sendFriendRequest still refuses it
}

// ─── UGC moderation (App Store Guideline 1.2) ────────────────────────────────

// A viewer's flag on another user's post. ONE row per (post, reporter) — a
// re-report upserts the same row instead of stacking duplicates, so the unique
// key is the idempotency guard. resolvedById is a plain string (NOT a FK) so
// deleting an admin account never erases the audit trail (mirrors
// ModerationEvent.reviewedById).
model ContentReport {
  id           String       @id @default(cuid())
  postId       String
  post         Post         @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User         @relation("UserContentReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       ReportReason
  note         String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String? // free text, e.g. "uphold" | "overturn"

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

enum ReportReason {
  OBJECTIONABLE
  ABUSE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
}

// A DIRECTIONAL block: blocker no longer sees (or is seen by) blocked.
// Deliberately separate from Friendship — that row is symmetric (one canonical
// row per pair) and cannot express who blocked whom, which unblock needs
// (only the blocker may lift it). Visibility exclusion is bidirectional:
// moderation.blockedIdsFor() unions both directions.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ─── Organization (lesswhelmed Aspiration Core) ─────────────────────────────
// Aspiration = a high-level user goal. Project = a concrete Focus Area under an
// Aspiration (or standalone). Posts/submissions are filed under one Project.

model Aspiration {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int?
  metadata    Json? // seam: later intake-question config / automation rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("UserAspirations", fields: [ownerId], references: [id], onDelete: Cascade)

  projects Project[] @relation("AspirationProjects")

  @@index([ownerId, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("active") // "active" | "archived" (mirrors IngestSubmission status style)
  sortOrder   Int?
  metadata    Json? // seam: later intake-question config / automation rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("UserProjects", fields: [ownerId], references: [id], onDelete: Cascade)

  // Standalone-capable: a Project may have no Aspiration.
  aspirationId String?
  aspiration   Aspiration? @relation("AspirationProjects", fields: [aspirationId], references: [id], onDelete: SetNull)

  posts       Post[]             @relation("ProjectPosts")
  submissions IngestSubmission[] @relation("ProjectSubmissions")
  embedding   ProjectEmbedding?  @relation("ProjectEmbedding")

  @@index([ownerId, status, createdAt])
  @@index([aspirationId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // admin plugin
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// better-auth apiKey() plugin table. Backs the MCP corpus server: users mint
// per-user API keys from /settings; apps/mcp verifies a Bearer key → owning
// userId. ALL fields are plugin-managed (input:false) — never write this table
// directly; go through auth.api.createApiKey / deleteApiKey / verifyApiKey.
// The owner FK is `referenceId` (the plugin's `references` defaults to "user"),
// NOT `userId`. `key` stores the HASHED key; the plaintext is returned once on
// create and never persisted. `configId` defaults to "default" (multi-config
// support, unused here). permissions/metadata are serialized text.
model ApiKey {
  id                  String    @id @default(cuid())
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  user User @relation("UserApiKeys", fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}
