# Local plugin settings (per the .claude/<plugin>.local.md convention)
.claude/*.local.md

# Never commit API keys or local env
*.local
.env
.env.*

# The root .gitignore ignores all `.mcp.json` (local MCP configs), but THIS one
# is the plugin's core connection config and MUST be tracked. Re-include it.
# It contains no secrets — the API key is read from ${SIRIUS_MCP_API_KEY}.
!.mcp.json
